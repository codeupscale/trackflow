# Local development — native PHP + Docker infra.
#
#   cp .env.local.example .env && php artisan key:generate && php artisan config:clear
#
# This is the template that matches LOCAL_DEV.md. Do NOT copy the ROOT .env.example
# here: that one is Docker/Sail-shaped (DB_HOST=pgsql, REDIS_HOST=redis,
# REDIS_CLIENT=phpredis, DB_USERNAME=sail) and only works from inside the container.
# `backend/.env.example` is the CI/testing template (sqlite :memory:), not this either.

APP_NAME=TrackFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Postgres, published on 5433 to avoid clashing with a local 5432.
# These MUST match the root .env — the container initializes its user/password from
# there, and a mismatch makes every query 500 ("Server is not responding" on desktop).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=trackflow
DB_USERNAME=postgres
DB_PASSWORD=password

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Docker Redis, published on 6380 to avoid clashing with a local 6379.
#
# REDIS_CLIENT=predis is REQUIRED when running PHP natively. Laravel defaults to
# 'phpredis' (config/database.php), which is a C extension that a stock Homebrew/system
# PHP does not have — you get "Please make sure the PHP Redis extension is installed and
# enabled" the moment anything touches the cache, queue or session. predis/predis is a
# pure-PHP client and is already a composer dependency, so nothing needs installing.
# Only switch to phpredis if you have actually run `pecl install redis`.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=null

# Mailpit container — web UI on http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@trackflow.com
MAIL_FROM_NAME="${APP_NAME}"

# MinIO container standing in for S3 (credentials come from compose.yaml)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=trackflow-screenshots
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Desktop agent — minimum supported version (empty = disabled).
TIMER_MIN_AGENT_VERSION=

REVERB_APP_ID=trackflow
REVERB_APP_KEY=trackflow-key
REVERB_APP_SECRET=trackflow-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth — optional locally; leave blank to disable the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
