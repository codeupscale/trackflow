APP_NAME=TrackFlow
APP_ENV=testing
# Generate a throwaway key for local testing: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=trackflow_test
DB_USERNAME=trackflow
# Set to match your local/CI test Postgres password. Never commit a real value.
DB_PASSWORD=trackflow_test

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

MAIL_MAILER=array

FILESYSTEM_DISK=local

CORS_ALLOWED_ORIGINS=http://localhost:3000

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
